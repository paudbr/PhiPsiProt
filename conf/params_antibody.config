/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/params_antibody.config  v4
    ─────────────────────────────────────────────────────────────────────────────────
    Merge: add `includeConfig 'conf/params_antibody.config'` to nextflow.config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    // ── Antibody type ─────────────────────────────────────────────────────────────
    ab_type                = 'VHH'        // 'VHH' | 'scFv'
    ab_antigen_chain       = 'B'          // chain ID in the target PDB (B en flu_HA)

    // ── HLT-formatted inputs ──────────────────────────────────────────────────────
    ab_target_pdb          = null         // antigen PDB (chain B/T truncated)
    ab_framework_pdb       = null         // framework HLT PDB (chains H[L] + CDR REMARKs)

    // ── Epitope hotspots ──────────────────────────────────────────────────────────
    // Format: "B131,B132,B156" — chain letter + residue number (NOT T131)
    ab_hotspot_residues    = null

    // ── CDR loop lengths ──────────────────────────────────────────────────────────
    // VHH:  "H1:7,H2:6,H3:5-13"
    // scFv: "H1:7,H2:6,H3:5-13,L1:8-13,L2:7,L3:9-11"
    ab_design_loops        = null

    // ── Model weights ─────────────────────────────────────────────────────────────
    ab_rfdiff_weights      = '/mnt/alphafold3_db/RFD/RFdiffusion_Ab.pt'
    ab_mpnn_weights        = '/mnt/alphafold3_db/RFD/ProteinMPNN_v48_noise_0.2.pt'
    ab_esmfold2_weights    = '/mnt/alphafold3_db/ESMFold2/models--biohub--ESMFold2-Fast'  // HuggingFace cache dir

    // ── RFdiffusion ───────────────────────────────────────────────────────────────
    ab_num_designs         = 50
    ab_rfdiff_args         = ''

    // ── ProteinMPNN ───────────────────────────────────────────────────────────────
    ab_seqs_per_struct     = 4
    ab_mpnn_temperature    = 0.2
    ab_mpnn_loops          = null
    ab_mpnn_args           = ''

    // ── ESMFold2 pre-filtro ───────────────────────────────────────────────────────
    ab_scoring_esm         = "${projectDir}/conf/scoring/scoring_ab_esmfold2.yaml"

    // ── AlphaFold3 filtro fino ────────────────────────────────────────────────────
    ab_af3_seeds           = 10
    ab_af3_args            = ''
    ab_scoring_af3         = "${projectDir}/conf/scoring/scoring_ab_af3.yaml"
    // Nota: el umbral ipTM está en el YAML (gates.iptm.min)
    // Para VHH: editar scoring_ab_af3.yaml → gates.iptm.min: 0.60
    // Para scFv: editar scoring_ab_af3.yaml → gates.iptm.min: 0.85

    // ── HADDOCK3 docking ──────────────────────────────────────────────────────────
    ab_run_haddock         = true
    ab_haddock_args        = ''
    ab_scoring_haddock3    = "${projectDir}/conf/scoring/scoring_ab_haddock3.yaml"
}

