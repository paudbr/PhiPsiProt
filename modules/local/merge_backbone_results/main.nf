/*
===============================================================================
MERGE_BACKBONE_RESULTS

Purpose:
Merge backbone-level metadata with ProteinMPNN sequence-design results.

Inputs:
- candidates_csv
    Output generated by BACKBONE_SUMMARY.

- mpnn_fastas
    FASTA files generated by PROTEINMPNN_DESIGN.

Outputs:
- merged_backbone_results.csv

Notes:
- Creates a unified candidate table for Mode 2.
- Associates each designed backbone with its corresponding ProteinMPNN sequence.
- Serves as the main input for downstream filtering steps.
===============================================================================
*/

process MERGE_BACKBONE_RESULTS {

    tag "merge_backbone_results"

    publishDir "${params.outdir}/intermediate", mode: 'copy'

    input:
    path candidates_csv
    path mpnn_fastas

    output:
    path "merged_backbone_results.csv"

    script:
    """
    python $projectDir/bin/merge_backbone_results.py \
        --candidates_csv $candidates_csv \
        --mpnn_fastas ${mpnn_fastas} \
        --output_csv merged_backbone_results.csv
    """
}